#!/bin/bash
# Géré par Ansible — toute modification manuelle sera écrasée
# Exécute une tâche programmée avec les hyperviseurs allumés : s'ils sont
# éteints, les réveille ensemble (Wake-on-LAN), attend que les machines
# répondent, lance la tâche, puis les rééteint (arrêt ou veille, selon
# wol_extinction). Ceux qui étaient déjà allumés le restent.
#
#   smb111-avec-pve ansible-playbook playbooks/check.yml
set -uo pipefail

# Une tâche à la fois : celle qui attend ne démarre qu'une fois les hyperviseurs
# rééteints par la précédente, et les réveille à son tour si besoin.
exec 9>"{{ admin_reveil_verrou }}"
flock 9

# nom adresse extinction, un hyperviseur par ligne
hyperviseurs=(
{% for h in groups['proxmox'] %}
  "{{ h }} {{ hostvars[h].hyperviseur_ip_lan }} {{ hostvars[h].wol_extinction | default('poweroff') }}"
{% endfor %}
)
repond() { timeout 2 bash -c ": > /dev/tcp/$1/22" 2>/dev/null; }

eteints=()
for ligne in "${hyperviseurs[@]}"; do
  read -r nom ip _ <<<"$ligne"
  repond "$ip" || eteints+=("$ligne")
done

if [ -n "${eteints[*]:-}" ]; then
  echo "Hyperviseur(s) éteint(s) : réveil avant la tâche."
  {{ admin_reveil_commande }} || exit 1
  # Les VM démarrent après l'hyperviseur : la tâche part quand toutes répondent
  ansible all -m ansible.builtin.wait_for_connection -a "timeout={{ admin_reveil_attente }}" \
    || echo "Certaines machines ne répondent pas encore, la tâche est lancée quand même."
  # Au démarrage, l'heure n'est synchronisée qu'après quelques instants (fw sort
  # sur Internet, les VM internes passent par lui) : check.yml la contrôle.
  ansible all -m ansible.builtin.shell -a "for _ in \$(seq {{ (admin_reveil_attente_ntp | int / 5) | int }}); do
      [ \"\$(timedatectl show -p NTPSynchronized --value)\" = yes ] && exit 0; sleep 5; done; exit 1" \
    || echo "Heure pas encore synchronisée partout, la tâche est lancée quand même."
fi

"$@"
rc=$?

# Extinction de ceux qui étaient éteints avant la tâche (arrêt ou veille)
if [ -n "${eteints[*]:-}" ]; then
  noms=()
  for ligne in "${eteints[@]}"; do read -r nom _ <<<"$ligne"; noms+=("$nom"); done
  echo "Extinction de ${noms[*]}, éteints avant la tâche."
  {{ admin_extinction_commande }} "${noms[@]}"
fi

exit "$rc"
