#!/bin/bash
# Géré par Ansible — réveille les hyperviseurs par Wake-on-LAN, puis attend qu'ils répondent.
# Ils sont réveillés ensemble : un nœud seul n'a pas le quorum du cluster et ne
# démarre pas ses VM (docs/cluster-proxmox.md).
#   reveil-pve
set -euo pipefail

# nom adresse, un hyperviseur par ligne
hyperviseurs=(
{% for h in groups['proxmox'] %}
  "{{ h }} {{ hostvars[h].hyperviseur_ip_lan }}"
{% endfor %}
)

repond() { timeout 2 bash -c ": > /dev/tcp/$1/{{ wol_test_port }}" 2>/dev/null; }

attendus=()
for ligne in "${hyperviseurs[@]}"; do
  read -r nom ip <<<"$ligne"
  if repond "$ip"; then
    echo "$nom est déjà allumé ($ip)."
    continue
  fi
  fichier="{{ wol_dossier_mac }}/$nom.mac"
  if [ ! -r "$fichier" ]; then
    echo "$nom : MAC inconnue ($fichier), à relever avec site.yml --limit $nom --tags wol." >&2
    continue
  fi
  mac="$(cat "$fichier")"
  wakeonlan -i {{ wol_broadcast }} "$mac" >/dev/null
  echo "Paquet magique envoyé à $nom ($mac)."
  attendus+=("$ligne")
done

[ -z "${attendus[*]:-}" ] && exit 0
echo "Attente du démarrage (5 minutes au plus)…"

for _ in $(seq 1 100); do
  restants=()
  for ligne in "${attendus[@]}"; do
    read -r nom ip <<<"$ligne"
    repond "$ip" || restants+=("$ligne")
  done
  if [ -z "${restants[*]:-}" ]; then
    echo "Les hyperviseurs répondent. Les VM démarrent seules (option onboot)."
    exit 0
  fi
  attendus=("${restants[@]}")
  sleep 3
done

for ligne in "${attendus[@]}"; do
  read -r nom ip <<<"$ligne"
  echo "$nom ne répond pas après 5 minutes : vérifier le BIOS (Wake-on-LAN), la veille et le câble réseau." >&2
done
exit 1
