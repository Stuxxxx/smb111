# Géré par Ansible — toute modification manuelle sera écrasée
# Tous les conteneurs utilisent le réseau de l'hôte : aucun port publié par
# Docker (ses règles contourneraient le pare-feu de sup). Seul nginx écoute
# sur {{ supervision_ip }} ; les autres sur 127.0.0.1.
name: supervision

services:
  prometheus:
    image: {{ supervision_images.prometheus }}
    network_mode: host
    user: "{{ supervision_uid.prometheus }}:{{ supervision_uid.prometheus }}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ supervision_retention_metriques }}
      - --web.listen-address=127.0.0.1:9090
      - --web.enable-remote-write-receiver
      - --web.enable-lifecycle
    volumes:
      - {{ supervision_dir }}/prometheus:/etc/prometheus:ro
      - {{ supervision_donnees }}/prometheus:/prometheus
    restart: unless-stopped

  alertmanager:
    image: {{ supervision_images.alertmanager }}
    network_mode: host
    user: "{{ supervision_uid.alertmanager }}:{{ supervision_uid.alertmanager }}"
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=127.0.0.1:9093
      - --web.external-url=https://{{ supervision_nom }}:{{ supervision_port_alertes }}
      - --cluster.listen-address=
    volumes:
      - {{ supervision_dir }}/alertmanager:/etc/alertmanager:ro
      - {{ supervision_donnees }}/alertmanager:/alertmanager
    restart: unless-stopped

  loki:
    image: {{ supervision_images.loki }}
    network_mode: host
    user: "{{ supervision_uid.loki }}:{{ supervision_uid.loki }}"
    command:
      - -config.file=/etc/loki/loki.yml
    volumes:
      - {{ supervision_dir }}/loki:/etc/loki:ro
      - {{ supervision_donnees }}/loki:/loki
    restart: unless-stopped

  grafana:
    image: {{ supervision_images.grafana }}
    network_mode: host
    user: "{{ supervision_uid.grafana }}:{{ supervision_uid.grafana }}"
    env_file: {{ supervision_dir }}/grafana/grafana.env
    volumes:
      - {{ supervision_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ supervision_dir }}/grafana/tableaux:/etc/grafana/tableaux:ro
      - {{ supervision_donnees }}/grafana:/var/lib/grafana
    depends_on: [prometheus, loki, alertmanager]
    restart: unless-stopped

  nginx:
    image: {{ supervision_images.nginx }}
    network_mode: host
    volumes:
      - {{ supervision_dir }}/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ pki_certificats_dir }}:/etc/ssl/smb111:ro
    depends_on: [grafana]
    restart: unless-stopped
