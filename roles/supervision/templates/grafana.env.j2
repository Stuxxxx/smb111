# Géré par Ansible — toute modification manuelle sera écrasée
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000
GF_SERVER_ROOT_URL=https://{{ supervision_nom }}/
# Le mot de passe n'est appliqué qu'à la création de la base de Grafana :
# ensuite, le changer avec grafana cli (docs/supervision.md)
GF_SECURITY_ADMIN_USER={{ supervision_grafana_admin }}
GF_SECURITY_ADMIN_PASSWORD={{ supervision_grafana_admin_mdp }}
GF_SECURITY_COOKIE_SECURE=true
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_LANGUAGE=fr-FR
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
{% if supervision_oidc %}

# Connexion par Keycloak (OIDC, flux « code » avec PKCE). Les rôles viennent
# des groupes Keycloak (jeton, attribut groups) ; hors de ces groupes, refusé.
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ supervision_oidc_client }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ supervision_oidc_secret }}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_AUTH_URL={{ supervision_oidc_url }}/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL={{ supervision_oidc_url }}/token
GF_AUTH_GENERIC_OAUTH_API_URL={{ supervision_oidc_url }}/userinfo
GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA=/etc/ssl/smb111-racine.crt
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], '{{ supervision_oidc_groupe_admin }}') && 'Admin' || contains(groups[*], '{{ supervision_oidc_groupe_lecture }}') && 'Viewer'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_SIGNOUT_REDIRECT_URL={{ supervision_oidc_url }}/logout?client_id={{ supervision_oidc_client }}&post_logout_redirect_uri=https%3A%2F%2F{{ supervision_nom }}%2Flogin
{% endif %}
