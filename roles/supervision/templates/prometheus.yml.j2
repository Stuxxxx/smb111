# Géré par Ansible — toute modification manuelle sera écrasée
# Les machines n'ont pas à être interrogées : leurs agents (Alloy) envoient
# leurs métriques (remote write). Prometheus n'interroge que la supervision.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/regles/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
{% for job, port in {'prometheus': 9090, 'alertmanager': 9093, 'loki': 3100, 'grafana': 3000}.items() %}
  - job_name: {{ job }}
    static_configs:
      - targets: ["127.0.0.1:{{ port }}"]
        labels:
          instance: {{ supervision_hote }}
{% endfor %}
